#!/usr/bin/env bash
# lil-mp-launcher: the combined (LIL-pattern) container entrypoint for
# cb3-class images — the stock-LMCache MP server and the vLLM engine in
# ONE container.
#
# Why one container: cross-container CUDA IPC (lmcache_driven transfer)
# needs shared /dev/shm, and even with ipc:host on both, the server holds
# IPC handles into the engine's KV tensors — an engine-only restart cannot
# re-allocate its VRAM until the server dies too. One container gives one
# /dev/shm and one lifecycle; the server is a child of the entrypoint.
#
# Flow: start `lmcache server` as a background child (L1 = host RAM, L2 =
# NVMe under /l2), wait for its monitor endpoint (HTTP :$METRICS_PORT
# /metrics), then exec `vllm serve` with the caller's args plus a
# LMCacheMPConnector pointing at tcp://localhost:$PORT — unless the caller
# passes their own --kv-transfer-config (then theirs wins; the server
# stays up regardless).
#
# Knobs (environment):
#   LMCACHE_L1_GB         L1 (host RAM) tier size, GiB   (default 32)
#   LMCACHE_L2_GB         L2 (NVMe) capacity, GiB        (default 160)
#   LMCACHE_L2_PATH       L2 directory, mounted by the
#                         deployment                     (default /l2)
#   LMCACHE_PORT          server ZMQ port                (default 5555)
#   LMCACHE_METRICS_PORT  server HTTP port (health)      (default 8080)
#
# The deployment mounts the NVMe tier at /l2 and sizes the container's
# shm to hold the transfer buffers.
set -euo pipefail

L1_GB="${LMCACHE_L1_GB:-32}"
L2_GB="${LMCACHE_L2_GB:-160}"
L2_PATH="${LMCACHE_L2_PATH:-/l2}"
PORT="${LMCACHE_PORT:-5555}"
METRICS_PORT="${LMCACHE_METRICS_PORT:-8080}"

# --- stock-LMCache MP server (background child) -----------------------------
# Chunk size is a minimum; the connector negotiates up to the engine's
# attention page. Object-group separation stays on (default): hybrid GDN
# recurrent states cache as their own object group.
#
# L2: without --l2-adapter the server has NO disk tier — the L2Eviction-
# Controller starts regardless and L1 eviction just drops objects (cost
# us a 97.1s "from-disk" reload that was really a cold re-prefill).
# fs_native with an eviction block bounds usage at max_capacity_gb
# (LRU, watermark 0.8 / ratio 0.2 defaults). Stores go to ALL tiers by
# default (--l2-store-policy default), so every KV lands on NVMe too.
L2_SPEC="{\"type\":\"fs_native\",\"base_path\":\"$L2_PATH\",\
\"max_capacity_gb\":$L2_GB,\"eviction\":{\"eviction_policy\":\"LRU\"}}"
lmcache server \
    --host 127.0.0.1 --port "$PORT" \
    --supported-transfer-mode auto \
    --l1-size-gb "$L1_GB" \
    --eviction-policy LRU \
    --l2-adapter "$L2_SPEC" &
LMCACHE_PID=$!
trap 'kill "$LMCACHE_PID" 2>/dev/null || true' EXIT

# Wait for the server before the engine connects, so registration never
# races it. The monitor (HTTP :$METRICS_PORT) starts with the server; it
# has no /health path, /metrics is its real endpoint.
READY=0
for _ in $(seq 1 60); do
    if curl -sf "http://127.0.0.1:$METRICS_PORT/metrics" >/dev/null 2>&1; then
        READY=1
        break
    fi
    sleep 2
done
if [[ "$READY" == 1 ]]; then
    echo "lmcache-server ready on :$PORT (pid $LMCACHE_PID, L1=${L1_GB} GiB, L2=${L2_GB} GiB)"
else
    echo "WARNING: lmcache-server not healthy on :$METRICS_PORT after 120s; continuing —" \
         "the engine fails at connector registration if it needs the server" >&2
fi

# --- vLLM engine ------------------------------------------------------------
# Inject the MP connector only when the caller does not bring their own.
has_kvtc=0
for a in "$@"; do
    if [[ "$a" == "--kv-transfer-config" ]]; then
        has_kvtc=1
    fi
done
if [[ "$has_kvtc" == 0 ]]; then
    set -- vllm serve \
        --kv-transfer-config "{\"kv_connector\":\"LMCacheMPConnector\",\"kv_role\":\"kv_both\",\"kv_connector_extra_config\":{\"lmcache.mp.host\":\"tcp://localhost\",\"lmcache.mp.port\":$PORT}}" \
        "$@"
else
    set -- vllm serve "$@"
fi

# exec: vLLM replaces this shell, becomes the container's main process and
# receives its signals; the lmcache child dies with the PID namespace when
# the container stops.
exec "$@"
